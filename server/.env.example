#
# 이 파일을 복사해 server/.env 로 만들고 값을 채우세요:  cp .env.example .env
# ⚠️ .env 는 커밋하지 마세요 (.gitignore 에 의해 제외됩니다). 키는 서버 측에만 존재해야 합니다.

# 필수: Anthropic API 키 (형식 예: sk-ant-...). 브라우저·저장소에 절대 넣지 마세요.
ANTHROPIC_API_KEY=

# 선택: 프록시 포트 (기본 8787). ai/config.js 의 AI_ENDPOINT 포트와 일치시키세요.
PORT=8787

# 선택: CORS 허용 오리진 (기본 "*"; 운영 시 정적 사이트 오리진으로 좁히세요)
# ALLOW_ORIGIN=http://localhost:8925

# 선택: 모델 ID (기본 claude-haiku-4-5 — 비용 우선). 품질을 높이려면 아래처럼 상향:
# AI_MODEL=claude-sonnet-5
# AI_MODEL=claude-opus-5

# 선택: 사고 강도 effort (기본 low). Haiku 모델에는 적용되지 않습니다.
# AI_EFFORT=low

# 선택: 비용 가드레일
# AI_RATE_PER_MIN=20            # IP당 분당 요청 상한(초과 시 429 {fallback:true})
# AI_MONTHLY_TOKEN_CAP=2000000  # 월간 토큰 예산(초과 시 429 {fallback:true})
